{
  "name": "parfumee-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api:types": "openapi-typescript ../api/openapi.json --output src/api/schema.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "ra-i18n-polyglot": "^5.15.7",
    "ra-language-french": "^5.15.7",
    "react": "^19.3.1",
    "react-admin": "^5.15.7",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
