{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.4.1",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.7.6",
        "gesdinet/jwt-refresh-token-bundle": "^3.1",
        "lexik/jwt-authentication-bundle": "^3.2",
        "liip/imagine-bundle": "^2.18.2",
        "nelmio/api-doc-bundle": "^5.13",
        "symfony/asset": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.30",
        "phpstan/phpstan": "^2.3.5",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^12.5.44",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/maker-bundle": "^1.68",
        "zenstruck/foundry": "^2.16"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "lint:cs": "php-cs-fixer fix --dry-run --diff",
        "lint:phpstan": "phpstan analyse --memory-limit=1G",
        "lint:container": "@php bin/console lint:container",
        "lint:schema": "@php bin/console doctrine:schema:validate --skip-sync",
        "lint": [
            "@lint:cs",
            "@lint:phpstan",
            "@lint:container"
        ],
        "fix-cs": "php-cs-fixer fix",
        "openapi:dump": "@php bin/console nelmio:apidoc:dump --format=json --env=test > openapi.json",
        "test": "phpunit",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "scripts-descriptions": {
        "lint:cs": "Check the coding style without changing files",
        "lint:phpstan": "Run the static analysis (phpstan.dist.neon)",
        "lint:container": "Check that every service can be built",
        "lint:schema": "Check the Doctrine mapping (fails until B15 is fixed)",
        "lint": "Run every linter",
        "fix-cs": "Fix the coding style",
        "openapi:dump": "Regenerate openapi.json, the committed OpenAPI contract",
        "test": "Run the test suite (needs the test database: docker compose up -d)",
        "check": "Run the linters, then the tests: what the CI will run"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
