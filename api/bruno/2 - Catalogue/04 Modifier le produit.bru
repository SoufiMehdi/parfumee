meta {
  name: 04 Modifier le produit
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/edit-product/{{productId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bougie Été à l'Ambre",
    "price": 26.5,
    "category_id": "{{categoryId}}",
    "attributes": {
      "weight": 200,
      "fragrance": "ambre",
      "size": "L"
    }
  }
}

tests {
  test("200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.equal(bru.getVar("productId"));
  });
}
