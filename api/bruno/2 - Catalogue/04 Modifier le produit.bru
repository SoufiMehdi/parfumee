meta {
  name: 04 Modifier le produit
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/admin/products/{{productId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bougie Été à l'Ambre",
    "price": 26.5,
    "category_id": "{{categoryId}}",
    "attributes": {
      "weight": 200,
      "fragrance": "ambre",
      "size": "L"
    }
  }
}

tests {
  test("200 et le produit modifié", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("productId"));
    expect(res.getBody().price).to.equal(26.5);
    expect(res.getBody().attributes.size).to.equal("L");
  });
}
