meta {
  name: 03 Détail du produit
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/shop/products/{{productId}}
  body: none
  auth: none
}

tests {
  test("200, avec un slug sans accent", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().slug).to.match(/^bougie-ete-a-l-ambre(-\d+)?$/);
    expect(res.getBody().attributes.weight).to.equal(180);
  });
}
