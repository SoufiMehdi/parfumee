meta {
  name: 04 Liste des utilisateurs
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/users/list
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const me = res.getBody().find((user) => user.email === bru.getEnvVar("adminEmail"));
    if (me) {
      bru.setVar("userId", me.id);
    }
  }
}

tests {
  test("200 et une liste (403 : le compte n'est pas encore administrateur)", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}

docs {
  Réservée aux administrateurs. Enregistre l'identifiant du compte connecté dans `userId` : la connexion ne le renvoie pas.
}
