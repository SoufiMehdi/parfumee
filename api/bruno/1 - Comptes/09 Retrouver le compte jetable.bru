meta {
  name: 09 Retrouver le compte jetable
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/admin/users?q={{throwawayEmail}}
  body: none
  auth: bearer
}

params:query {
  q: {{throwawayEmail}}
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().items.length === 1) {
    bru.setVar("throwawayId", res.getBody().items[0].id);
  }
}

tests {
  test("la recherche trouve le compte jetable, et lui seul", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().pagination.total).to.equal(1);
    expect(res.getBody().items[0].email).to.equal(bru.getVar("throwawayEmail"));
  });
}

docs {
  Retrouve le compte jetable par une recherche sur son email : il est trouvé quel que soit le nombre de comptes, sans dépendre de la page.
}
