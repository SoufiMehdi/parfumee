meta {
  name: 06 Modifier mon compte
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/shop/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "first_name": "Ada",
    "last_name": "Admin",
    "phone_number": "+33612345679"
  }
}

tests {
  test("200 et le nouveau téléphone", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().phoneNumber).to.equal("+33612345679");
  });
}
