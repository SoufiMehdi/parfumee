###> nelmio/cors-bundle ###
# Default ports of the dev servers: Next.js or Nuxt for the shop, Vite for the back-office.
# Another port: override them in .env.dev.local.
CORS_SHOP_ORIGIN=http://localhost:3000
CORS_ADMIN_ORIGIN=http://localhost:5173
###< nelmio/cors-bundle ###
