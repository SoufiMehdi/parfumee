# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
XDEBUG_MODE=coverage

# Définir l'environnement sur 'test'
APP_ENV=test
APP_SECRET="a8f8287f3bc775837a28e5772ef91981" # Utilise un secret bidon pour les tests

# --- BASE DE DONNÉES DE TEST ---
# Service `database_test` de compose.override.yaml : `docker compose up -d`.
# Le nom de base réel est `app_test` : Doctrine ajoute le suffixe `_test` (config/packages/doctrine.yaml).
# Identifiants jetables, sans valeur hors de ce conteneur local.
DATABASE_URL="postgresql://test:test@127.0.0.1:54320/app?serverVersion=16&charset=utf8"

DEFAULT_URI=/public/uploads/

