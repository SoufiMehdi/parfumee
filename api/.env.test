# Test-only values. They are committed and public: never reuse them anywhere else.
# Note: .env.local is NOT loaded in the test environment; use .env.test.local for local overrides.
KERNEL_CLASS='App\Kernel'
APP_SECRET=a8f8287f3bc775837a28e5772ef91981

# Same passphrase as .env.dev: tests sign real JWTs with the local key pair (config/jwt/*.pem).
JWT_PASSPHRASE=22ad2a92e9f51888ca344994eb552d8e4630d183e600a0cf6efc2d4e2c3d0690

# --- BASE DE DONNÉES DE TEST ---
# Service `database_test` de compose.override.yaml : `docker compose up -d`.
# Le nom de base réel est `app_test` : Doctrine ajoute le suffixe `_test` (config/packages/doctrine.yaml).
# Identifiants jetables, sans valeur hors de ce conteneur local.
DATABASE_URL="postgresql://test:test@127.0.0.1:54320/app?serverVersion=16&charset=utf8"

DEFAULT_URI=/public/uploads/

# Fronts allowed to call the API from a browser (see .env). Fake origins, used by CorsTest.
CORS_SHOP_ORIGIN=https://shop.example.test
CORS_ADMIN_ORIGIN=https://admin.example.test
